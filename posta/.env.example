# Kopiraj to datoteko v .env in nastavi vrednosti
# cp .env.example .env

# Obvezno: dolg naključni niz
# Ustvari ga z: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=zamenjaj-z-naklucnim-nizom-vsaj-32-znakov

# Začetno geslo admin računa (privzeto admin/Admin123! — OBVEZNO zamenjaj)
ADMIN_PASSWORD=ZamenjajGeslo123!

# ── Shranjevanje podatkov ───────────────────────────────────────────────
# Na Renderju z diskom: nastavi DATA_DIR na priklopno pot diska.
# Baza (SQLite) se bo shranjevala tam in bo trajna.
DATA_DIR=/var/data

# Za lokalni razvoj lahko DATA_DIR pustiš prazno — baza bo v mapi projekta.

# (Neobvezno) Če bi raje uporabljal PostgreSQL namesto SQLite na disku,
# nastavi DATABASE_URL. Takrat DATA_DIR ni potreben.
# DATABASE_URL=postgresql://user:geslo@host:5432/narocilnice

# ── Branje šasijske številke (VIN) iz slike ─────────────────────────────
# Bralniki se uporabijo po tem vrstnem redu; dovolj je eden.
#
# 1) Vizualni model (PRIPOROČENO) – razume, kaj VIN je, zato zna ločiti
#    šasijsko številko od registrske ali kode motorja na isti sliki.
#    Ključ dobiš v Google AI Studio.
GEMINI_API_KEY=
# Model lahko vsiliš; brez tega ga aplikacija izbere sama iz Googlovega seznama.
GEMINI_MODEL=

# 2) Google Cloud Vision – klasični OCR, bere znake, VIN izluščimo sami.
GOOGLE_VISION_API_KEY=
# Varnostna dnevna meja poizvedb na Google Vision (privzeto 200)
VISION_DAILY_LIMIT=200

# Brez obeh ključev aplikacija pade na Tesseract v brskalniku, ki je za
# šasijske številke slab. Stanje preveriš na strani /vehicles/vin-test.

# ── Pošiljanje povpraševanj po e-pošti (s prilogami) ────────────────────
# Brez teh nastavitev gumb „Pošlji po mailu" še vedno dela, a odpre poštni
# program in priloge je treba pripeti ročno (brskalnik jih prek mailto ne
# zna pripeti). Ko so nastavljene, pošto s slikami pošlje aplikacija sama.
#
# Gmail / Google Workspace: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587.
#   Za SMTP_PASS NE uporabi gesla za prijavo, ampak „geslo za aplikacije"
#   (Google račun → Varnost → Prijava v dveh korakih → Gesla za aplikacije).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Naslov pošiljatelja; če je prazno, se uporabi SMTP_USER.
SMTP_FROM=
# starttls (vrata 587, privzeto) | ssl (vrata 465) | none
SMTP_SECURITY=starttls

# (Neobvezno) Privzeti e-naslov dobavitelja, ki se vpiše sam.
MAIL_DEFAULT_TO=
# (Neobvezno) Kam naj dobavitelj odgovori. Brez tega odgovor pride na SMTP_FROM.
MAIL_REPLY_TO=
